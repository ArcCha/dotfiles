# Desktop identity inherited by Sway and applications launched from it.
export XDG_CURRENT_DESKTOP='sway'
export XDG_SESSION_DESKTOP='sway'

# Input method environment inherited by Sway and applications launched from it.
# GTK Wayland applications use the compositor's native text-input protocol.
export XMODIFIERS='@im=fcitx'
export QT_IM_MODULE='fcitx'

# Start Sway after a local login on the first virtual console. Using exec means
# that exiting Sway ends the login session and returns to the console prompt.
if [[ -z "${WAYLAND_DISPLAY:-}" && -z "${SSH_CONNECTION:-}" && "${XDG_VTNR:-}" == 1 ]]; then
  exec sway --unsupported-gpu
fi

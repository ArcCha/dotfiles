# Sway configuration for terra

set $mod Mod4
set $term foot
set $menu fuzzel
set $lock swaylock -f -c 002b36

font pango:DejaVu Sans Mono 10
floating_modifier $mod normal

# Dual 4K displays connected to the NVIDIA GPU over DisplayPort.
output DP-6 mode 3840x2160@60Hz position 0,0 scale 1
output DP-5 mode 3840x2160@60Hz position 3840,0 scale 1
output * bg /usr/share/backgrounds/sway/Sway_Wallpaper_Blue_1920x1080.png fill

input type:keyboard {
    xkb_layout pl
    repeat_delay 200
    repeat_rate 30
    xkb_numlock enabled
}

# Input method variables are exported by ~/.zprofile before Sway starts.
# Make the Wayland session available to user services and D-Bus activation.
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XMODIFIERS QT_IM_MODULE

exec fcitx5 -d --replace
exec waybar
exec mako
exec swayidle -w \
    timeout 300 "$lock" \
    timeout 600 'swaymsg "output * power off"' \
        resume 'swaymsg "output * power on"' \
    before-sleep "$lock"
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec udiskie

# Applications
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill

# Focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Move containers
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Splits and layouts: preserve the old i3 bindings.
bindsym $mod+Shift+v splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Session controls
bindsym $mod+Shift+c reload
bindsym $mod+Shift+e exec swaynag -t warning \
    -m 'Exit Sway and end this Wayland session?' \
    -B 'Yes, exit' 'swaymsg exit'

mode "resize" {
    bindsym h resize shrink width 10px
    bindsym j resize grow height 10px
    bindsym k resize shrink height 10px
    bindsym l resize grow width 10px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# PipeWire/PulseAudio controls
bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym --locked XF86AudioMute exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym --locked XF86AudioMicMute exec pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioStop exec playerctl stop

# Screenshots are written by grim to its timestamped default filename.
bindsym Print exec grim
bindsym Shift+Print exec grim -g "$(slurp)"

set $mode_system System: (l) lock, (e) logout, (s) suspend, (r) reboot, (Shift+s) power off
mode "$mode_system" {
    bindsym l exec $lock, mode "default"
    bindsym e exec swaymsg exit, mode "default"
    bindsym s exec $lock && systemctl suspend, mode "default"
    bindsym r exec systemctl reboot, mode "default"
    bindsym Shift+s exec systemctl poweroff, mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+Pause mode "$mode_system"

# Solarized window colors
client.focused          #859900 #859900 #fdf6e3 #859900 #859900
client.focused_inactive #073642 #073642 #eee8d5 #6c71c4 #073642
client.unfocused        #073642 #073642 #93a1a1 #586e75 #073642
client.urgent           #d33682 #d33682 #fdf6e3 #dc322f #d33682

include /etc/sway/config.d/*
